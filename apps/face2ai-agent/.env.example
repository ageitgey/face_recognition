# ---- Face2AI backend (must be running) ----
FACE2AI_URL=http://127.0.0.1:8765

# ---- Agent behaviour ----
FACE2AI_AGENT_LANGUAGE=de            # de | en | ...
FACE2AI_AGENT_NAME=Face2AI
# FACE2AI_AGENT_PERSONA=Du bist ...  # optional: replaces the default persona paragraph
FACE2AI_AGENT_GREET_KNOWN=on
FACE2AI_AGENT_GREET_UNKNOWN=on
FACE2AI_AGENT_ANNOUNCE_MULTIPLE=on
FACE2AI_AGENT_GREETING_STYLE=llm     # llm (natural, via LLM) | say (fixed sentence via TTS)
FACE2AI_AGENT_UNKNOWN_COOLDOWN_SECONDS=120
FACE2AI_AGENT_REGREET_AFTER_SECONDS=90  # same person again only after being away this long (server cooldown still applies)

# ---- Hermes as the brain (your own agent: memory, tools, persona) ----
# HERMES_API_SERVER_KEY=            # = API_SERVER_KEY of the Hermes gateway; with it, `auto` picks hermes
# HERMES_API_SERVER_URL=http://127.0.0.1:8642/v1   # SSH-tunnelled from the VPS (com.hermes.tunnel9119 forwards 8642 too)
# HERMES_SESSION_KEY=face2ai-voice  # scopes Hermes' long-term memory to this voice channel

# ---- Keys (set what you have; `auto` picks the cheapest available) ----
# OPENROUTER_API_KEY=sk-or-...        # free models -> LLM at 0 EUR (rate-limited)
# GROQ_API_KEY=gsk_...                # cheap/free-tier LLM + Whisper STT
# OPENAI_API_KEY=sk-...               # paid fallback for LLM / STT / TTS

# ---- Provider overrides (optional) ----
# FACE2AI_AGENT_LLM=auto              # auto | openrouter | groq | openai | ollama | custom
# FACE2AI_AGENT_LLM_MODEL=openai/gpt-oss-20b:free
# FACE2AI_AGENT_LLM_FALLBACKS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# FACE2AI_AGENT_LLM_BASE_URL=         # for custom / ollama
# FACE2AI_AGENT_STT=auto              # auto | local | groq | openai
# FACE2AI_AGENT_STT_BASE_URL=http://127.0.0.1:8000/v1     # speaches (faster-whisper)
# FACE2AI_AGENT_STT_MODEL=Systran/faster-whisper-small
# FACE2AI_AGENT_TTS=auto              # auto | local | openai
# FACE2AI_AGENT_TTS_BASE_URL=http://127.0.0.1:8880/v1     # Kokoro-FastAPI (or speaches :8000)
# FACE2AI_AGENT_TTS_MODEL=kokoro      # speaches: speaches-ai/Kokoro-82M-v1.0-ONNX or a piper-de_DE-* voice model
# FACE2AI_AGENT_TTS_VOICE=af_heart
